# Copy to .env and fill in. .env is gitignored and must stay that way.

# Sepolia RPC endpoint. Used by the ENSv2 fork test and by script/Deploy.s.sol.
# The fork test needs eth_getLogs over a 50000 block range to find a live name;
# https://ethereum-sepolia-rpc.publicnode.com serves that. Without this variable
# test/ENSv2NameGuardFork.t.sol skips itself and forge test still runs offline.
SEPOLIA_RPC_URL=

# Deployer key, funded with Sepolia ETH. Only needed for --broadcast.
PRIVATE_KEY=

# For forge script --verify.
ETHERSCAN_API_KEY=

# Optional. Defaults are the ENSv2 ETHRegistry on Sepolia and ROLE_SET_RESOLVER.
# ENS_ETH_REGISTRY=0xBDC85dD5b15D7ecb354cd7cb6f2c50b4f2c4F0E2
# ENS_PUBLISH_ROLE=16777216
